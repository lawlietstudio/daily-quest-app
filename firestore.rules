rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Allow read/write access to all users under any conditions
      // Warning: This is insecure. Configure Authentication and specific rules for production.
      
      // OPTION 1: Open to everyone (simplest for prototyping)
      // allow read, write: if true;

      // OPTION 2: Open until a specific date (what you likely had before)
      // extended to 30 days from now
      allow read, write: if request.time < timestamp.date(2026, 2, 20);
    }
  }
}
